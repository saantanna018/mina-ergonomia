# ── Claves y tokens (NUNCA subir el .env real a git) ─────────────────
# API key de OpenAI (https://platform.openai.com). Si falta, el miner
# funciona en modo MOCK: genera un artículo de muestra determinista para
# poder validar el pipeline completo sin coste.
OPENAI_API_KEY=

# Modelo OpenAI para la generación de artículos.
OPENAI_MODEL=gpt-4o

# Tag de Amazon Afiliados España (tu Tracking ID real de afiliados.amazon.es,
# formato: nombre-21). Sin esto el miner aborta el ciclo en vez de publicar
# enlaces sin comisión.
AMAZON_ASSOCIATES_TAG=

# URL canónica del sitio en producción (para sitemap, OG y JSON-LD)
SITE_URL=https://ergolab-pro.example

# Nº máximo de titulares de contexto que se inyectan al prompt
MAX_NEWS_ITEMS=6
