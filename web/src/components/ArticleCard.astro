---
interface Props {
  slug: string;
  title: string;
  excerpt: string;
  pubDate: Date;
  tags: string[];
  featured?: boolean;
}

const { slug, title, excerpt, pubDate, tags, featured = false } = Astro.props;
const dateStr = pubDate.toLocaleDateString("es-ES", { day: "numeric", month: "long", year: "numeric" });
---

<a
  href={`/articulos/${slug}/`}
  class:list={[
    "lift group block rounded-2xl border border-stone-200 bg-white p-6 shadow-sm hover:shadow-lg dark:border-stone-800 dark:bg-stone-900",
    featured && "sm:col-span-2 sm:p-8",
  ]}
>
  <div class="flex flex-wrap items-center gap-2">
    {featured && (
      <span class="rounded-full bg-gradient-to-r from-accent-500 to-accent-700 px-2.5 py-0.5 text-[11px] font-bold tracking-wide text-white uppercase">
        Destacado
      </span>
    )}
    {tags.slice(0, 3).map((tag) => (
      <span class="rounded-full bg-stone-100 px-2.5 py-0.5 text-[11px] font-medium text-stone-500 dark:bg-stone-800 dark:text-stone-400">
        {tag}
      </span>
    ))}
  </div>
  <h2
    class:list={[
      "mt-3 font-bold tracking-tight text-stone-900 transition-colors group-hover:text-accent-600 dark:text-stone-100 dark:group-hover:text-accent-400",
      featured ? "text-2xl leading-snug" : "text-lg leading-snug",
    ]}
  >
    {title}
  </h2>
  <p class="mt-2.5 line-clamp-3 text-sm leading-relaxed text-stone-500 dark:text-stone-400">{excerpt}</p>
  <div class="mt-4 flex items-center justify-between">
    <time class="text-xs text-stone-400 dark:text-stone-500" datetime={pubDate.toISOString()}>{dateStr}</time>
    <span class="text-sm font-semibold text-accent-600 transition-transform duration-200 group-hover:translate-x-1 dark:text-accent-400">
      Leer análisis →
    </span>
  </div>
</a>
