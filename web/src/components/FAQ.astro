---
interface Props {
  items: { q: string; a: string }[];
}

const { items } = Astro.props;
---

<div class="space-y-3">
  {items.map((item) => (
    <details class="group rounded-2xl border border-stone-200 bg-white shadow-sm transition-shadow open:shadow-md dark:border-stone-800 dark:bg-stone-900">
      <summary class="flex cursor-pointer items-center justify-between gap-4 px-5 py-4 text-sm font-semibold text-stone-800 select-none dark:text-stone-200">
        {item.q}
        <span class="text-accent-500 transition-transform duration-200 group-open:rotate-45">＋</span>
      </summary>
      <p class="px-5 pb-5 text-sm leading-relaxed text-stone-600 dark:text-stone-400">{item.a}</p>
    </details>
  ))}
</div>
