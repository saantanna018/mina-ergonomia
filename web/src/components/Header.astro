---
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="sticky top-0 z-40 border-b border-stone-200/70 bg-stone-50/85 backdrop-blur-md dark:border-stone-800/70 dark:bg-stone-950/85">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-5 py-4 sm:px-8">
    <a href="/" class="group flex items-center gap-2.5" aria-label="ErgoLab, inicio">
      <span class="grid size-9 place-items-center rounded-2xl bg-gradient-to-br from-accent-500 to-accent-700 text-sm font-black text-white shadow-sm transition-transform duration-200 group-hover:scale-105">
        E
      </span>
      <span class="text-lg font-bold tracking-tight">
        Ergo<span class="text-accent-600 dark:text-accent-400">Lab</span>
      </span>
    </a>
    <nav class="flex items-center gap-1 sm:gap-2">
      <a href="/" class="rounded-xl px-3 py-2 text-sm font-medium text-stone-600 transition-colors hover:bg-stone-200/60 hover:text-stone-900 dark:text-stone-400 dark:hover:bg-stone-800/60 dark:hover:text-stone-100">
        Análisis
      </a>
      <a href="/aviso-afiliados" class="hidden rounded-xl px-3 py-2 text-sm font-medium text-stone-600 transition-colors hover:bg-stone-200/60 hover:text-stone-900 sm:block dark:text-stone-400 dark:hover:bg-stone-800/60 dark:hover:text-stone-100">
        Cómo nos financiamos
      </a>
      <ThemeToggle />
    </nav>
  </div>
</header>
